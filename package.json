{
  "name": "sidp-survey-hub",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && npm run check:edge && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "check:edge": "tsc -p tsconfig.edge.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tesseract.js-data/por": "^1.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.5.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
